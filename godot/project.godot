config_version=5

[application]
config/name="PolyForge Character Study"
run/main_scene="res://studio.tscn"

[display]
window/size/viewport_width=1040
window/size/viewport_height=740
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.075, 0.09, 0.105, 1)
